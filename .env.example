# Save beside compose.yaml as .env. Fill the six empty secrets below.
# Only Docker Engine and Docker Compose v2 are needed on the server.
# The Compose file pins the release image. Optional override for an upgrade:
# RUNOZA_IMAGE=ghcr.io/liderman/runoza:vX.Y.Z

COMPOSE_PROFILES=local-db,local-storage

# Local access or an HTTPS reverse proxy on this host.
# For a proxy on another host, bind to the server's LAN IP or 0.0.0.0.
BIND_ADDRESS=127.0.0.1
PORT=3000
# Set the exact browser address, without a trailing slash.
# Remote access requires HTTPS, e.g. https://runoza.example.org.
PUBLIC_ORIGIN=http://127.0.0.1:3000

# Use a different random value for each secret. A password manager can generate
# them; if OpenSSL is available, run `openssl rand -hex 32` for each value.
# POSTGRES_PASSWORD: use only letters and digits (it is included in a URL).
POSTGRES_PASSWORD=
# Storage credentials; random letters and digits work for both values.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Each encryption key must be exactly 64 hexadecimal characters (0-9, a-f).
# Keep both keys across upgrades and back them up with the data.
SECRETS_KEY=
PROVIDER_SECRETS_KEY=
# At least 32 random characters. Enter this when creating the first admin.
BOOTSTRAP_TOKEN=

S3_BUCKET=runoza
S3_REGION=us-east-1
S3_PATH_STYLE=true
LOG_LEVEL=info
OIDC_ALLOW_INSECURE_HTTP=false

# External PostgreSQL: remove local-db from COMPOSE_PROFILES and set DATABASE_URL.
# DATABASE_URL=postgresql://user:password@db.example.org:5432/runoza?sslmode=verify-full
# External S3: remove local-storage from COMPOSE_PROFILES and set S3_ENDPOINT.
# S3_ENDPOINT=https://s3.example.org

# Optional operator allowlist of exact internal MCP origins (comma-separated).
MCP_ALLOWED_INTERNAL_ORIGINS=
# Additional exact HTTPS origins allowed for MCP OAuth discovery/token endpoints.
MCP_OAUTH_ALLOWED_ORIGINS=
MCP_CATALOG_MAX_TOOLS=2000

# Shared Open Terminal uses upstream multi-user accounts for a trusted organization.
# Its API key is generated automatically and kept in the terminal-key Docker volume.
TERMINAL_MEMORY=2g
TERMINAL_CPUS=2
# Optional external multi-user Open Terminal (give this installation its own instance):
# SHARED_TERMINAL_URL=https://terminal.example.org
# SHARED_TERMINAL_API_KEY=
