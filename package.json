{
  "name": "runoza",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.5.1 <12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:spike": "vite build --config spikes/stage0/vite.config.ts",
    "test:spike": "tsx --test spikes/stage0/*.test.ts",
    "dev:spike": "vite --config spikes/stage0/vite.config.ts",
    "build": "npm run build:server && npm run build:desktop",
    "lint": "node scripts/check-boundaries.mjs && prettier --check apps packages scripts tests deploy .github",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "start": "node apps/server/dist/main.js",
    "worker": "node apps/worker/dist/main.js",
    "migrate": "node apps/migrate/dist/main.js",
    "licenses": "node scripts/licenses.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:ui && npm run licenses",
    "format": "prettier --write apps packages scripts tests deploy .github",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:desktop": "vite build --config apps/desktop/vite.config.ts",
    "desktop": "electron apps/desktop",
    "package:desktop": "npm run build:desktop && node scripts/package-desktop.mjs",
    "build:server": "tsc -p tsconfig.build.json && node scripts/build.mjs && npm run build:web",
    "test:ui": "vitest run --config tests/ui/vitest.config.ts",
    "runoza": "node scripts/runoza.mjs",
    "package:cli": "npm run build:server && node scripts/package-cli.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@aws-sdk/lib-storage": "3.1166.0",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@gravity-ui/aikit": "3.4.0",
    "@gravity-ui/i18n": "1.8.0",
    "@gravity-ui/uikit": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "jsdom": "31.0.0",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "prettier": "3.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.18",
    "smol-toml": "1.9.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
